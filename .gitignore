# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml
/ml/.venv/
/ml/results/*
!/ml/results/saved_embeddings.npz
!/ml/results/val_sources.json
!/ml/results/classifier_weights.npz
!/ml/results/classifier_labels.json
!/ml/results/model_card.json
**/.DS_Store
__pycache__/
*.py[cod]
package-lock.json

# Audio datasets are large and may have separate redistribution licenses.
/dataset/external/esc50/audio/
/dataset/external/freesound/
/dataset/background/
/dataset/siren/
/dataset/unknown/
/dataset/inbox/
/dataset/**/*.wav
/dataset/**/*.mp3
/dataset/recorder/**/*.json
/ml/dsp_cache

# Environment config (contains IPs, credentials)
.env
config.mk
/esp32/secrets.yaml

# IDE and tooling
/.idea/
/.claude/
/.tokensave/

# Label Studio local data
/label-studio/data/
/label-studio/export.json

# Freesound audio (downloaded locally)
/dataset/external/freesound/audio/
ml/emb_cache/
