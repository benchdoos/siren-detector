# ESP32 secrets — copy to secrets.yaml and fill in real values.
# secrets.yaml is gitignored.

wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"

# Fallback AP password (used when Wi-Fi is unavailable)
ap_password: "changeme"

# UDP target: IP and port of the host running Hub (e.g. Raspberry Pi)
udp_target_ip: "192.168.1.100"
udp_target_port: "9000"
