# =============================================================================
# Sound Detector — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit it with real credentials.
# =============================================================================

# ── Your host (deployment target) ────────────────────────────────────────

# SSH connection string: user@ip or user@hostname
RPI=user@192.168.1.100

# Base project directory on RPi
RPI_BASE=~/Projects/esphome

# Docker container name for the detector engine
CONTAINER=siren-detector-engine

# ── Web UI ──────────────────────────────────────────────────────────────────

# Full URL to the detector Web UI (used by `make open`)
WEB_UI=http://192.168.1.100:8080

# ── UDP Ports (Hub ↔ Detector ↔ Recorder) ──────────────────────────────────

# Port where Hub listens for ESP32 audio stream
HUB_PORT=9000

# Port where Recorder listens (Hub forwards here)
RECORDER_PORT=9001

# Port where Detector listens (Hub forwards here)
DETECTOR_PORT=9002

# ── MQTT (optional — leave empty to disable) ───────────────────────────────

# MQTT broker address (e.g. 127.0.0.1 or your broker hostname)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────────

# Enable admin auth for Web UI (true/false)
AUTH_ENABLED=true

# Admin token for Web UI — if empty, auto-generated on startup (see logs)
ADMIN_TOKEN=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SESSION_SECRET=
OIDC_ROLE_CLAIM=roles
OIDC_ROLE_MAP=viewer=viewer,editor=editor,admin=admin
OIDC_COOKIE_SECURE=true

# ── ESP32 Audio Target ──────────────────────────────────────────────────────

# IP address of the host receiving UDP audio from ESP32
# (must match the IP in esp32/siren-detector.yaml substitutions)
# By default - Hub listening host and port
UDP_TARGET_IP=192.168.1.100
UDP_TARGET_PORT=9000
