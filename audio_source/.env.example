# =============================================================================
# Audio Source — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# =============================================================================

# SDR1 source_id (uint16). Must be unique across all audio sources.
# 0 = ESP32 default, use 1+ for additional mics.
AUDIO_SOURCE_ID=1

# UDP target: host:port of the Hub (or detector directly).
AUDIO_TARGET=127.0.0.1:9000

# Audio gain multiplier (increase if mic is too quiet).
AUDIO_SOURCE_GAIN=1.0

# Audio device: index number, name substring, or "default".
# Run `docker compose run --rm audio-source --list-devices` to see available devices.
AUDIO_DEVICE=default

# Host user ID for PulseAudio socket path (/run/user/<UID>/pulse).
# On most systems this is 1000. Check with: id -u
HOST_UID=1000
