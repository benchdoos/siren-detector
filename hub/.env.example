# =============================================================================
# Hub + Detector — Docker Compose Environment
# =============================================================================
# Copy this file to .env in the same directory:
#   cp .env.example .env
#
# Docker Compose reads this file automatically.
# =============================================================================

# ── UDP Ports ───────────────────────────────────────────────────────────────

# Hub: incoming ESP32 audio stream
HUB_PORT=9000

# Recorder: Hub forwards audio here (on-demand recording)
RECORDER_PORT=9001

# Detector: Hub forwards audio here (ML inference)
DETECTOR_PORT=9002

# ── MQTT (optional — leave empty to disable) ───────────────────────────────

MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────────

# Enable admin auth for Web UI labeling and settings
AUTH_ENABLED=true

# Admin token — if empty, auto-generated on startup (check logs)
ADMIN_TOKEN=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SESSION_SECRET=
OIDC_ROLE_CLAIM=roles
OIDC_ROLE_MAP=viewer=viewer,editor=editor,admin=admin
OIDC_COOKIE_SECURE=true
