  "runtime.desc": "\u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u0430\u0443\u0434\u0438\u043e \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0416\u0438\u0437\u043d\u0435\u043d\u043d\u044b\u0439 \u0446\u0438\u043a\u043b, \u0432\u0435\u0440\u0441\u0438\u044f \u0438 \u043e\u0448\u0438\u0431\u043a\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u0441\u044f \u0432 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0435 \u0434\u0432\u0438\u0436\u043a\u0430.",
  "runtime.loading": "\u0417\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f...",
  "runtime.no_subscribers": "\u041d\u0435\u0442 \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u0430\u0443\u0434\u0438\u043e.",
  "runtime.no_outputs": "\u0412\u044b\u0445\u043e\u0434\u043d\u044b\u0435 \u0430\u0434\u0430\u043f\u0442\u0435\u0440\u044b \u043d\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u044b.",
  "runtime.frames_processed": "\u043a\u0430\u0434\u0440\u043e\u0432 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043e",
  "runtime.dropped": "\u043f\u043e\u0442\u0435\u0440\u044f\u043d\u043e",
  "runtime.sequence_gaps": "\u043f\u0440\u043e\u043f\u0443\u0441\u043a\u043e\u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438",
  "runtime.callback_errors": "\u043e\u0448\u0438\u0431\u043e\u043a \u043a\u043e\u043b\u043b\u0431\u044d\u043a\u043e\u0432",
  "runtime.failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 runtime",

  "cal.desc": "\u0417\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0444\u043e\u043d\u043e\u0432\u044b\u0439 \u0448\u0443\u043c \u0441 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d\u0430, \u0447\u0442\u043e\u0431\u044b \u043c\u043e\u0434\u0435\u043b\u044c \u043d\u0430\u0443\u0447\u0438\u043b\u0430\u0441\u044c \u043e\u0442\u043b\u0438\u0447\u0430\u0442\u044c \u0444\u043e\u043d \u043e\u0442 \u0441\u0438\u0440\u0435\u043d\u044b.",
  "cal.tips_title": "\u041a\u0430\u043a \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043b\u0443\u0447\u0448\u0438\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442:",
  "cal.tip1": "\u0417\u0430\u043f\u0438\u0448\u0438\u0442\u0435 5+ \u043c\u0438\u043d\u0443\u0442 \u043e\u0431\u044b\u0447\u043d\u043e\u0439 \u043e\u0431\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438",
  "cal.tip2": "\u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0440\u0430\u0437\u043d\u044b\u0435 \u0437\u0432\u0443\u043a\u0438: \u0431\u044b\u0442\u043e\u0432\u044b\u0435 \u043f\u0440\u0438\u0431\u043e\u0440\u044b, \u0443\u043b\u0438\u0446\u0443, \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u044b, 3D-\u043f\u0440\u0438\u043d\u0442\u0435\u0440\u044b \u0438 \u0442.\u0434.",
  "cal.tip3": "\u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0439\u0442\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0435\u0441\u0441\u0438\u0439 \u0432 \u0440\u0430\u0437\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0441\u0443\u0442\u043e\u043a",
  "cal.tip4": "\u041a\u0430\u0436\u0434\u043e\u043c\u0443 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0443 (ESP32, USB-\u043c\u0438\u043a) \u043d\u0443\u0436\u043d\u0430 \u0441\u0432\u043e\u044f \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430",
  "cal.tip5": "\u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 make retrain",
  "cal.source": "\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a",
  "cal.duration": "\u0414\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c (\u0441\u0435\u043a)",
  "cal.preset_5min": "5 \u043c\u0438\u043d",
  "cal.preset_10min": "10 \u043c\u0438\u043d",
  "cal.preset_15min": "15 \u043c\u0438\u043d",
  "cal.recording": "\u0417\u0430\u043f\u0438\u0441\u044c...",
  "cal.recording_in_progress": "\u0417\u0430\u043f\u0438\u0441\u044c \u0432\u0435\u0434\u0451\u0442\u0441\u044f...",
  "cal.done_saving": "\u0413\u043e\u0442\u043e\u0432\u043e! \u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435...",
  "cal.cancelled": "\u041e\u0442\u043c\u0435\u043d\u0435\u043d\u043e \u2014 \u0437\u0430\u043f\u0438\u0441\u044c \u0443\u0434\u0430\u043b\u0435\u043d\u0430.",
  "cal.no_recordings": "\u0417\u0430\u043f\u0438\u0441\u0435\u0439 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0444\u043e\u0440\u043c\u0443 \u0432\u044b\u0448\u0435 \u0434\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0438 \u0444\u043e\u043d\u043e\u0432\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430.",
  "cal.failed_load": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u0438.",

  "about.title": "Siren Detector",
  "about.disclaimer_label": "\u041f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435",
  "about.disclaimer": "\u042d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0438 \u0432\u0441\u0435 \u0435\u0433\u043e \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u044b \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0434\u043b\u044f \u043c\u0438\u0440\u043d\u044b\u0445 \u0446\u0435\u043b\u0435\u0439. \u041b\u044e\u0431\u043e\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u044d\u0442\u043e\u0433\u043e \u041f\u041e \u0432 \u0432\u043e\u0435\u043d\u043d\u044b\u0445, \u0432\u0440\u0435\u0434\u043e\u043d\u043e\u0441\u043d\u044b\u0445 \u0438\u043b\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0446\u0435\u043b\u044f\u0445 \u0441\u0442\u0440\u043e\u0433\u043e \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043e.",
  "about.desc": "\u0423\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 \u0434\u0435\u0442\u0435\u043a\u0446\u0438\u0438 \u0437\u0432\u0443\u043a\u043e\u0432\u044b\u0445 \u0441\u043e\u0431\u044b\u0442\u0438\u0439. ESP32-S3 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0430\u0443\u0434\u0438\u043e \u0441 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d\u0430 INMP441 \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0435\u0433\u043e \u0434\u0432\u0438\u0436\u043a\u0443 \u0434\u0435\u0442\u0435\u043a\u0446\u0438\u0438 \u043d\u0430 \u0431\u0430\u0437\u0435 YAMNet + MLP.",
  "about.target_classes": "\u0426\u0435\u043b\u0435\u0432\u044b\u0435 \u043a\u043b\u0430\u0441\u0441\u044b:",
  "about.repo": "\u0420\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439",
  "about.license": "\u041b\u0438\u0446\u0435\u043d\u0437\u0438\u044f",
  "about.license_text": "CC BY-NC 4.0",
  "about.as_is": "\u042d\u0442\u043e \u041f\u041e \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u00ab\u043a\u0430\u043a \u0435\u0441\u0442\u044c\u00bb, \u0431\u0435\u0437 \u043a\u0430\u043a\u0438\u0445-\u043b\u0438\u0431\u043e \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0439. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c, \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0442\u044c \u0438 \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e \u0434\u043b\u044f \u043d\u0435\u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0438\u0445 \u0446\u0435\u043b\u0435\u0439 \u043f\u0440\u0438 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0438 \u0430\u0432\u0442\u043e\u0440\u0441\u0442\u0432\u0430 \u0438 \u0441\u0441\u044b\u043b\u043a\u0438 \u043d\u0430 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439.",

  "detection.mode_desc": "Определяет, как движок обрабатывает аудио из нескольких источников. Переключается на лету после сохранения.",
  "detection.round_robin": "По очереди",
  "detection.round_robin_desc": "\u2014 один поток обрабатывает источники по очереди. Меньше пиковая нагрузка на CPU.",
  "detection.parallel": "Параллельно",
  "detection.parallel_desc": "\u2014 по потоку инференса на источник. Одновременная обработка, может увеличить пиковую нагрузку.",
  "detection.default_rr": "По умолчанию: round_robin",
  "detection.interval_desc": "Интервал между проходами модели для каждого источника. Больше значение = меньше CPU, но задержка детекции.",
  "detection.interval_range": "Диапазон: 0.25 \u2013 2.0 сек",
  "detection.interval_default": "По умолчанию: 0.5",

  "threshold.desc": "Минимальная уверенность модели для каждого типа звука. При активном MLP (сирена) применяется к выходу MLP.",
  "threshold.siren": "Порог сирены",
  "threshold.siren_desc": "Уверенность MLP для каждого детекта сирены, чтобы он засчитался как триггер. Ниже = чувствительнее, но больше ложных срабатываний.",
  "threshold.range": "Диапазон: 0.0 \u2013 1.0",
  "threshold.siren_default": "По умолчанию: 0.10",

  "dsp_setting.desc": "Лёгкая Conv1D модель, пропускающая YAMNet при уверенном фоне, экономя CPU.",
  "dsp_setting.enabled": "DSP-префильтр",
  "dsp_setting.enabled_desc": "Когда включён, DSP-классификатор предварительно фильтрует аудио перед YAMNet. Уверенный фон пропускается, снижая нагрузку до 90%.",
  "dsp_setting.enabled_default": "По умолчанию: Вкл",
  "dsp_setting.bg_threshold": "Порог фона DSP",
  "dsp_setting.bg_release": "Порог отпускания фона DSP",
  "dsp_setting.bg_windows": "Окна подтверждения фона DSP",
  "dsp_setting.event_gate": "Порог события DSP",
  "dsp_setting.max_skips": "Макс. последовательных пропусков DSP",

  "click.desc": "Подавляет импульсный шум (щелчки, хлопки) от INMP441 перед инференсом. Предотвращает ложные «Взрывы» от электрических помех.",
  "click.enabled": "Удаление щелчков",
  "click.threshold": "Порог удаления щелчков",
  "click.max_width": "Макс. ширина щелчка",

  "gate.yamnet_min": "Мин. порог YAMNet",

  "trigger.possible": "Триггеров для «возможно»",
  "trigger.confirmed": "Триггеров для «подтверждено»",
  "trigger.smoothing_window": "Окно сглаживания",
  "trigger.cooldown": "Пауза (Cooldown)",
  "trigger.refractory": "Рефрактерный таймаут",

  "clip.length": "Длина клипа",
  "clip.from_possible": "Клип с момента «возможно»",
  "clip.save_bg": "Сохранять фоновые сегменты",
  "clip.user_length": "Длина пользовательского клипа",

  "tip.detection_mode": "<strong>Режим детекции</strong><br>Определяет, как движок обрабатывает аудио из нескольких источников. Переключается на лету после сохранения.<hr><b style=\"color:#4caf50\">По очереди</b> — один поток обрабатывает источники по очереди. Меньше пиковая нагрузка на CPU.<br><br><b style=\"color:#4caf50\">Параллельно</b> — по потоку инференса на источник. Одновременная обработка, может увеличить пиковую нагрузку.<hr><span class=\"s-tip-default\">По умолчанию: <b>round_robin</b></span>",
  "tip.inference_interval_seconds": "<strong>Интервал инференса</strong><br>Интервал между проходами модели для каждого источника. Больше — меньше нагрузка на CPU, но задержка детекции и пропуск коротких звуков.<hr><span class=\"s-tip-range\">Диапазон: <b>0.25 – 2.0 сек</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>0.5</b></span>",
  "tip.siren_threshold": "<strong>Порог сирены</strong><br>Уверенность MLP для детекции сирены, чтобы засчиталось как триггер. Ниже = чувствительнее, но больше ложных срабатываний.<hr><span class=\"s-tip-range\">Диапазон: <b>0.0 – 1.0</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>0.10</b></span>",
  "tip.explosion_threshold": "<strong>Порог взрыва</strong><br>Уверенность YAMNet для взрыва/выстрела/хлопка. Классы: Explosion, Burst pop, Gunshot gunfire.<hr><span class=\"s-tip-range\">Диапазон: <b>0.0 – 1.0</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>0.15</b></span>",
  "tip.uav_threshold": "<strong>Порог БПЛА</strong><br>Уверенность YAMNet для звуков двигателей БПЛА.<hr><span class=\"s-tip-range\">Диапазон: <b>0.0 – 1.0</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>0.15</b></span>",
  "tip.dsp_enabled": "<strong>DSP-префильтр</strong><br>При включении лёгкий DSP-классификатор фильтрует аудио перед YAMNet. Уверенный фон пропускается, снижая нагрузку на CPU до 90%. Выключите для полного инференса YAMNet.<hr><span class=\"s-tip-default\">По умолчанию: <b>Вкл</b></span>",
  "tip.dsp_bg_threshold": "<strong>Порог фона DSP</strong><br>Минимальная уверенность DSP для пропуска YAMNet. Выше = консервативнее (меньше пропусков, ниже риск пропустить событие). Ниже = агрессивнее (больше пропусков, меньше CPU).<hr><span class=\"s-tip-range\">Диапазон: <b>0.50 – 1.00</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>0.85</b></span>",
  "tip.dsp_bg_release_threshold": "<strong>Порог отпускания фона DSP</strong><br>Пока DSP пропускает YAMNet, он возобновляет YAMNet когда уверенность фона падает ниже этого значения. Выше — быстрее возврат к YAMNet; ниже — дольше пропуск.<hr><span class=\"s-tip-range\">Диапазон: <b>0.50 – 1.00</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>0.85</b></span>",
  "tip.dsp_bg_confirm_windows": "<strong>Окна подтверждения фона DSP</strong><br>Сколько подряд уверенных предсказаний «фон» нужно, чтобы DSP начал пропускать YAMNet. Больше — надёжнее, но чаще запускает YAMNet.<hr><span class=\"s-tip-range\">Диапазон: <b>1 – 10 окон</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>2</b></span>",
  "tip.dsp_event_gate": "<strong>Порог события DSP</strong><br>Если вероятность любого класса событий (сирена, взрыв, БПЛА) выше этого порога — всегда запускать YAMNet, даже при высокой уверенности фона. Ниже = чувствительнее. 0 = отключено.<hr><span class=\"s-tip-range\">Диапазон: <b>0.00 – 0.50</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>0.08</b></span>",
  "tip.dsp_max_consecutive_skips": "<strong>Макс. пропусков подряд DSP</strong><br>После стольких пропусков DSP подряд — принудительный запуск YAMNet. Низкие значения (3-5) позволяют YAMNet ловить события быстрее несмотря на медленное 5с-окно DSP. Выше = больше экономия CPU, но задержка детекции. 0 = отключено.<hr><span class=\"s-tip-range\">Диапазон: <b>0 – 200</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>4</b> (~2 секунды)</span>",
  "tip.click_removal_enabled": "<strong>Удаление щелчков</strong><br>При включении обнаруживает импульсный шум (пики в 1-5 сэмплов от электрических помех) и заменяет их интерполированными значениями перед инференсом YAMNet. Реальные взрывы длятся сотни сэмплов и не затрагиваются.<hr><span class=\"s-tip-default\">По умолчанию: <b>Вкл</b></span>",
  "tip.click_removal_threshold": "<strong>Порог удаления щелчков</strong><br>На сколько MAD (медианных абсолютных отклонений) сэмпл должен превышать медиану, чтобы считаться щелчком. Ниже = агрессивнее (может срезать громкие звуки). Выше = только экстремальные пики.<hr><span class=\"s-tip-range\">Диапазон: <b>3.0 – 50.0</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>10.0</b></span>",
  "tip.click_removal_max_width": "<strong>Макс. ширина щелчка</strong><br>Максимальное число подряд идущих аномальных сэмплов для удаления. Группы длиннее этого не трогаются (скорее всего реальный звук). Щелчки INMP441 обычно 1-5 сэмплов.<hr><span class=\"s-tip-range\">Диапазон: <b>1 – 20 сэмплов</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>5</b></span>",
  "tip.yamnet_min_gate": "<strong>Мин. порог YAMNet</strong><br>YAMNet должен показать хотя бы такую оценку, чтобы результат MLP считался достоверным. Предотвращает галлюцинации MLP на незнакомом аудио. 0 = полностью доверять MLP.<hr><span class=\"s-tip-range\">Диапазон: <b>0.0 – 1.0</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>0.01</b></span>",
  "tip.possible_triggers": "<strong>Триггеры для «возможно»</strong><br>Сколько окон с превышением порога нужно для раннего предупреждения (жёлтый бейдж). Клип ещё не сохраняется.<hr><span class=\"s-tip-range\">Диапазон: <b>1 – 60</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>4</b></span>",
  "tip.confirmed_triggers": "<strong>Триггеры для «подтверждено»</strong><br>Сколько окон нужно для подтверждения события. Сохраняет клип, отправляет MQTT. Должно быть больше «возможно».<hr><span class=\"s-tip-range\">Диапазон: <b>1 – 60</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>8</b></span>",
  "tip.smoothing_window_seconds": "<strong>Окно сглаживания</strong><br>Скользящее временное окно для накопления триггеров. 30с при 0.5с инференса = до 61 слота.<hr><span class=\"s-tip-range\">Диапазон: <b>5 – 120 сек</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>30</b></span>",
  "tip.cooldown_seconds": "<strong>Пауза (Cooldown)</strong><br>После подтверждённого события игнорировать детекции столько времени. Предотвращает дубликаты. 0 = без паузы.<hr><span class=\"s-tip-range\">Диапазон: <b>0 – 600 сек</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>60</b></span>",
  "tip.refractory_seconds": "<strong>Рефрактерный период</strong><br>После cooldown ждёт падения оценки перед повторным включением. Если оценка остаётся высокой — истекает по таймауту. 0 = отключено.<hr><span class=\"s-tip-range\">Диапазон: <b>0 – 120 сек</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>15</b></span>",
  "tip.clip_seconds": "<strong>Длина клипа</strong><br>Длительность сохранённого аудиоклипа. Короче = меньше шума для ретрейна.<hr><span class=\"s-tip-range\">Диапазон: <b>5 – 60 сек</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>10</b></span>",
  "tip.clip_from_possible": "<strong>Клип с «возможно»</strong><br>При включении клип записывается с момента перехода в «возможно» (+ 2с пре-буфер) вместо последних N секунд перед «подтверждено». Включает оценки по окнам в метаданные.<hr><span class=\"s-tip-default\">По умолчанию: <b>Выкл</b></span>",
  "tip.user_event_clip_seconds": "<strong>Длина пользовательского клипа</strong><br>Длительность записи при ручном создании события.<hr><span class=\"s-tip-range\">Диапазон: <b>5 – 60 сек</b></span><br><span class=\"s-tip-default\">По умолчанию: <b>15</b></span>",
  "tip.save_background_segments": "<strong>Сохранять фоновые сегменты</strong><br>При разметке аудиосегментов сохранять неразмеченные части как фоновые данные для обучения.<hr><span class=\"s-tip-default\">По умолчанию: <b>Выкл</b></span>",

